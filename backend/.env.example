# Server Configuration
PORT=5000
NODE_ENV=production

# JWT Secret (Change this in production!)
JWT_SECRET=your_jwt_secret_key_change_this_in_production

# Client URLs
CLIENT_URL=https://quicksell-80aad.web.app
SERVER_URL=https://your-backend-url.com
FRONTEND_URL=https://quicksell-80aad.web.app

# Firebase Admin SDK Configuration
# Get this from Firebase Console > Project Settings > Service Accounts
FIREBASE_SERVICE_ACCOUNT={"type":"service_account",...}
FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com

# Payment Gateways - AddPay
ADDPAY_CLIENT_ID=your_client_id
ADDPAY_CLIENT_SECRET=your_client_secret
ADDPAY_TEST_MODE=false

# Email Configuration (Brevo/SendinBlue)
BREVO_API_KEY=your_api_key
BREVO_SENDER_EMAIL=your_email@domain.com
BREVO_SENDER_NAME=Your_Company_Name
BREVO_SMTP_LOGIN=your_smtp_login
BREVO_SMTP_PASSWORD=your_smtp_password

# Admin Configuration
ADMIN_EMAIL=admin@yourdomain.com
TEST_EMAIL=test@yourdomain.com

# Shipping - SAPO (defaults baked into the service; override here if needed)
# SAPO_API_TOKEN=
# SAPO_TRN_TOKEN=
# SAPO_OFFICE_CD=
# SAPO_USER_FID=
# SAPO_MOCK_MODE=false

# Shipping - ShipLogic (nationwide courier). Active provider is set in the admin panel.
SHIPLOGIC_API_KEY=your_shiplogic_bearer_token
SHIPLOGIC_BASE_URL=https://api.shiplogic.com
SHIPLOGIC_WEBHOOK_SECRET=set_a_random_secret_and_use_it_in_the_webhook_url
SHIPLOGIC_MOCK_MODE=false

# Shipping - RTT Generic API v1.15 (booking + tracking). Active provider is set in the admin panel.
# Leave RTT_MOCK_MODE=true (and provider off) until RTT credentials + open items are confirmed.
RTT_BASE_URL=https://m.rtt.co.za
RTT_ACCOUNT_CODE=your_rtt_account_code
RTT_PIN=your_rtt_pin
RTT_API_KEY=optional_rtt_api_key_if_required
RTT_SERVICE_LEVEL=0
RTT_BARCODE_PREFIX=QS
RTT_WEBHOOK_SECRET=set_a_random_secret_and_use_it_in_the_webhook_url
RTT_MOCK_MODE=true

# Shipping - Pargo (Click & Collect / pickup-point). Active provider is set in the admin panel.
# Leave PARGO_MOCK_MODE=true (and provider off) until Pargo credentials + open items are confirmed.
PARGO_BASE_URL=https://api.pargo.co.za
PARGO_USERNAME=your_pargo_api_username
PARGO_PASSWORD=your_pargo_api_password
PARGO_MAP_TOKEN=your_pargo_map_token
PARGO_SUPPORT_NAME=Quicksell
PARGO_SUPPORT_PHONE=0000000000
PARGO_SUPPORT_EMAIL=info@quicksellsa.co.za
PARGO_WEBHOOK_SECRET=set_a_random_secret_and_use_it_in_the_webhook_url
PARGO_MOCK_MODE=true