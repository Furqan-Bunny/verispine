# Copy to backend/.env and fill in. .gitignore excludes .env — keep it that way.

# ---- Server ----
PORT=5000
NODE_ENV=production

# 64 random hex chars. Rotating this signs everyone out, which is the point.
JWT_SECRET=change_me

# ---- URLs ----
# CORS and the Socket.IO allowlist are derived from these plus FIREBASE_PROJECT_ID.
# There is no hardcoded domain list in the code.
FRONTEND_URL=https://marketplace.verispinejointcenters.com
CLIENT_URL=https://marketplace.verispinejointcenters.com
SERVER_URL=https://your-backend-url.com
# Optional, comma-separated, for any additional origins (preview deploys etc.)
EXTRA_CORS_ORIGINS=

# ---- Firebase Admin SDK ----
# Firebase Console → Project settings → Service accounts → Generate new private key.
# Paste the whole JSON on one line.
FIREBASE_SERVICE_ACCOUNT={"type":"service_account",...}
FIREBASE_PROJECT_ID=verispine-marketplace
FIREBASE_STORAGE_BUCKET=verispine-marketplace.firebasestorage.app

# ---- Payments: Stripe ----
# https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_your_key
# Webhook signing secret from https://dashboard.stripe.com/webhooks
#   Endpoint: https://<your-domain>/api/payments/stripe/webhook
#   Events:   checkout.session.completed, checkout.session.expired, charge.refunded
# The webhook — not the browser redirect — is what settles an order. Without it
# buyers pay and their orders sit at pending_payment forever.
STRIPE_WEBHOOK_SECRET=whsec_your_secret
# true = settle instantly without calling Stripe. Local and demo only.
STRIPE_MOCK_MODE=false

# ---- Email: Resend ----
RESEND_API_KEY=re_your_key
# Must be a domain verified in Resend, or every message silently bounces.
RESEND_SENDER_EMAIL=noreply@verispinejointcenters.com

# ---- Shipping: USPS ----
# https://developer.usps.com — APIs v3. Mock mode is ON unless set to false.
USPS_MOCK_MODE=true
USPS_BASE_URL=https://api.usps.com
USPS_CLIENT_ID=
USPS_CLIENT_SECRET=
USPS_ACCOUNT_NUMBER=

# ---- Shipping: UPS ----
# https://developer.ups.com. Mock mode is ON unless set to false.
UPS_MOCK_MODE=true
UPS_BASE_URL=https://onlinetools.ups.com
UPS_CLIENT_ID=
UPS_CLIENT_SECRET=
UPS_ACCOUNT_NUMBER=
UPS_SERVICE_CODE=03

# ---- Shipping: Freight (LTL) ----
# No credentials — freight is seller-quoted and admin-tracked. These only tune
# the indicative estimate shown at checkout; the binding number is the real quote.
FREIGHT_BASE_RATE=185
FREIGHT_RATE_PER_LB=0.42
FREIGHT_LIFTGATE_FEE=95
FREIGHT_RESIDENTIAL_FEE=120

# ---- Admin ----
ADMIN_EMAIL=admin@verispinejointcenters.com
