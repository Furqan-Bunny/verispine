# Copy to frontend/.env and fill in. Never commit the filled-in file — .gitignore
# already excludes it, which is a deliberate change from the codebase this was
# derived from (that one tracked .env with live keys).

# API Configuration — must include the /api suffix. Several services use this
# value verbatim in dev (the socket client strips /api back off itself).
VITE_API_URL=http://localhost:5000/api

# Firebase Configuration (Firebase Console → Project settings → Your apps → Web app)
# Not secret — these ship in the bundle. Access control is in firestore.rules.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project-id.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Stripe publishable key (pk_test_… / pk_live_…). The SECRET key belongs in the
# backend env only — a sk_ key here would be published to every visitor.
VITE_STRIPE_PUBLISHABLE_KEY=

# App Configuration
VITE_APP_NAME=VeriSpine
VITE_APP_URL=http://localhost:3000
